# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo del agente del producto. Sonnet 5 = calidad casi-Opus a bajo coste
# ($3/$15 por 1M tokens). Para pasos triviales usa Haiku 4.5; para trabajo
# offline exigente (resúmenes de pliegos) usa Opus 4.8/Fable 5 vía Batches.
CLAUDE_MODEL=claude-sonnet-5
# Juez de los evals. Debe ser al menos tan capaz como el agente que juzga, y
# conviene que sea otro modelo: si se juzga a sí mismo, se aprueba sus sesgos.
JUDGE_MODEL=claude-opus-4-8

# --- DuckDB (almacén analítico) ---
DUCKDB_PATH=data/radar.duckdb

# --- Postgres + pgvector (app + embeddings) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me

# --- Embeddings (búsqueda vectorial) ---
# Modelo local multilingüe que corre en CPU. BGE-m3 = 1024 dims. Cambiarlo
# implica ajustar la dimensión de vector() en search/schema.sql.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Ingesta ---
# Años a descargar de PLACSP (coma-separados)
PLACSP_YEARS=2024,2025

# --- Observabilidad (Langfuse Cloud free tier por defecto) ---
# Opcionales: sin claves, las trazas se escriben solo en data/trazas.jsonl y
# el agente funciona igual. Las claves se sacan de cloud.langfuse.com >
# Settings > API Keys, tras crear un proyecto.
# Ojo: enviar trazas manda a un servicio externo las preguntas y respuestas
# reales del agente.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Producción (VPS) ---
DOMAIN=radar.tudominio.com
