# --- Claude API ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo del agente del producto. Sonnet 5 = calidad casi-Opus a bajo coste
# ($3/$15 por 1M tokens). Para pasos triviales usa Haiku 4.5; para trabajo
# offline exigente (resúmenes de pliegos) usa Opus 4.8/Fable 5 vía Batches.
CLAUDE_MODEL=claude-sonnet-5
# Juez de los evals. Debe ser al menos tan capaz como el agente que juzga, y
# conviene que sea otro modelo: si se juzga a sí mismo, se aprueba sus sesgos.
JUDGE_MODEL=claude-opus-4-8

# --- DuckDB (almacén analítico) ---
DUCKDB_PATH=data/radar.duckdb

# --- Postgres + pgvector (app + embeddings) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me

# --- Embeddings (búsqueda vectorial) ---
# Modelo local multilingüe que corre en CPU. BGE-m3 = 1024 dims. Cambiarlo
# implica ajustar la dimensión de vector() en search/schema.sql.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Ingesta ---
# Años a descargar de PLACSP (coma-separados)
PLACSP_YEARS=2024,2025

# --- Observabilidad (Langfuse Cloud free tier por defecto) ---
# Opcionales: sin claves, las trazas se escriben solo en data/trazas.jsonl y
# el agente funciona igual. Las claves se sacan de cloud.langfuse.com >
# Settings > API Keys, tras crear un proyecto.
# Ojo: enviar trazas manda a un servicio externo las preguntas y respuestas
# reales del agente.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Auth (JWT propio) ---
# Genera uno real con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080

# --- Billing (Stripe) ---
# Opcionales para desarrollo: sin claves, /billing/* devuelve error explícito
# y el resto de la API funciona igual. Claves de test en
# dashboard.stripe.com > Developers > API keys; price_id se crean uno por
# plan en Product catalog (ver api/planes.py). El webhook secret sale de
# `stripe listen --forward-to localhost:8000/billing/webhook` en local.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ILIMITADO=
# En producción, cambiar por el dominio real (https://.../billing/exito y
# /billing/cancelado): son las URLs a las que Stripe redirige tras el pago.
BILLING_SUCCESS_URL=http://localhost:8000/billing/exito
BILLING_CANCEL_URL=http://localhost:8000/billing/cancelado

# --- Alertas (Resend) ---
# Opcional para desarrollo: sin clave, el job de alertas falla al enviar (no
# al buscar) y se registra el error sin tumbar las demás alertas. Clave en
# resend.com > API Keys; el dominio remitente debe estar verificado (TXT/MX)
# antes de que los envíos salgan de verdad.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alertas@radarcontratacion.com

# --- Producción (VPS) ---
DOMAIN=radarcontratacion.com
